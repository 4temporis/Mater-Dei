{
  "name": "mater-dei-pastoral-care",
  "version": "1.0.0",
  "private": true,
  "description": "Mater Dei Pastoral Care - Eucharistic Ministry & Homebound Tracker",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i web/input.css -o stitch_mater_dei_pastoral_tracker/assets/tailwind.css --minify",
    "build:js": "esbuild web/firebase-client.js --bundle --format=esm --platform=browser --target=es2020 --outfile=stitch_mater_dei_pastoral_tracker/firebase-client.js",
    "build:web": "npm run build:css && npm run build:js",
    "cap:sync": "npm run build:web && cap sync android",
    "android:debug": "cd android && gradlew.bat assembleDebug",
    "android:release": "cd android && gradlew.bat assembleRelease",
    "apk": "npm run cap:sync && npm run android:debug",
    "admin:create": "node scripts/create-admin.js",
    "firebase:setup": "node scripts/setup-firebase.js",
    "firebase:deploy-config": "node scripts/deploy-firebase-config.js",
    "functions:install": "cd functions && npm install",
    "functions:deploy": "firebase deploy --only functions",
    "inspect": "node scripts/inspect-firestore.js",
    "check:pages": "node scripts/check-imports.js && node scripts/check-pages.js",
    "seed": "node seed.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/push-notifications": "^8.1.3",
    "firebase": "^13.3.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.1",
    "tailwindcss": "^3.4.19"
  }
}
